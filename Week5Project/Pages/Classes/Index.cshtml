@page
@model Week5Project.Pages.Classes.IndexModel
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Class List";
}

<div class="dashboard-container">
    <header class="dashboard-header">
        <div class="header-content">
            <h1 class="dashboard-title">Classes SQL Manager</h1>
            <div class="user-controls">
                <div class="user-badge">
                    <i class="bi bi-person-circle"></i>
                    <span>@HttpContextAccessor.HttpContext.Session.GetString("username")</span>
                </div>
                <form method="post" asp-page-handler="Logout">
                    <button type="submit" class="logout-btn">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </header>

    <div class="dashboard-content">
        <div class="welcome-section">
            <h2>Class Management</h2>
            <p>View and manage your class information</p>
        </div>

        <div class="main-content-area">
            <div class="content-card">
                <div class="card-header">
                    <i class="bi bi-list-ul"></i> Class List
                    <a href="@Url.Page("./Create")" class="create-btn">
                        <i class="bi bi-plus-circle"></i> Create New Class
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Person Count</th>
                                    <th>Description</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var classItem in Model.ClassList)
                                {
                                    <tr>
                                        <td>@classItem.Name</td>
                                        <td>@classItem.PersonCount</td>
                                        <td>@classItem.Description</td>
                                        <td class="text-center">
                                            @if (classItem.IsActive)
                                            {
                                                <span class="status-badge status-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-inactive">Inactive</span>
                                            }
                                        </td>
                                        <td class="action-buttons">
                                            <a href="@Url.Page("./Details", new { id = classItem.Id })" class="btn-details">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                            <a href="@Url.Page("./Edit", new { id = classItem.Id })" class="btn-edit">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a href="@Url.Page("./Delete", new { id = classItem.Id })" class="btn-delete">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav class="pagination-container">
                        <ul class="pagination">
                            @foreach (var page in Model.GetPaginationPages())
                            {
                                if (page is string)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                else
                                {
                                    int pageNumber = (int)page;
                                    bool isActive = pageNumber == Model.CurrentPage;

                                    <li class="page-item @(isActive ? "active" : "")">
                                        <a class="page-link" href="?currentPage=@pageNumber">
                                            @pageNumber
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

